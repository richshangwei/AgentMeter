/desktop-p0/gen/

# Bundled third-party runtimes (not redistributed through Git)
/desktop-p0/resources/quota-helper/
/scripts/quota-smoke-support/node_modules/

# Release worktrees: full build trees, compiled binaries and signed installers.
# Never commit these to a public repository.
/.release-worktrees/

# Local scratch: developer screenshots, verification logs, machine-specific
