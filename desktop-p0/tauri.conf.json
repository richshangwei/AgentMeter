{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMeter P0",
  "version": "0.1.0",
  "identifier": "com.agentmeter.p0",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentMeter P0 — build 0.1.0",
        "width": 1080,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {"resources/quota-helper/": "quota-helper/"},
    "icon": [],
    "targets": "nsis",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
